+import sys
+import json
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+from django.contrib.admin.utils import display_for_field
+from django.db import models
+from django.test import SimpleTestCase
+
+
+# Helper functions for test setup/teardown and data construction:
+def setup_state():
+    """No state needed for this test."""
+    return None
+
+
+def teardown_state(state):
+    """No cleanup needed for this test."""
+    pass
+
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(
+    max_examples=2000,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test(data):
+    import os
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test that non-JSONField types still work correctly
+            # This should pass on both buggy and fixed versions
+            
+            # Draw a field type that is NOT JSONField but is already handled correctly
+            field_type = data.draw(st.sampled_from([
+                'CharField',
+                'IntegerField',
+                'FloatField',
+                'DecimalField',
+            ]))
+            
+            if field_type == 'CharField':
+                value = data.draw(st.text(min_size=0, max_size=100))
+                field = models.CharField()
+                result = display_for_field(value, field, '-empty-')
+                # CharField should display the value as-is
+                assert result == value
+                
+            elif field_type == 'IntegerField':
+                value = data.draw(st.integers(min_value=-1000000, max_value=1000000))
+                field = models.IntegerField()
+                result = display_for_field(value, field, '-empty-')
+                # IntegerField should be formatted as a number
+                assert isinstance(result, str)
+                
+            elif field_type == 'FloatField':
+                value = data.draw(st.floats(min_value=-1000000, max_value=1000000, allow_nan=False, allow_infinity=False))
+                field = models.FloatField()
+                result = display_for_field(value, field, '-empty-')
+                # FloatField should be formatted as a number
+                assert isinstance(result, str)
+                
+            elif field_type == 'DecimalField':
+                from decimal import Decimal
+                value = data.draw(st.decimals(min_value=-1000000, max_value=1000000, allow_nan=False, allow_infinity=False, places=2))
+                field = models.DecimalField(decimal_places=2)
+                result = display_for_field(value, field, '-empty-')
+                # DecimalField should be formatted as a number
+                assert isinstance(result, str)
+                
+        elif is_regression == "false":
+            # Reproduction test logic: Test the JSONField bug
+            # This should FAIL on buggy version, PASS on fixed version
+            
+            # Draw a JSON-serializable dictionary value
+            json_value = data.draw(st.dictionaries(
+                keys=st.text(min_size=1, max_size=20, alphabet=st.characters(min_codepoint=97, max_codepoint=122)),
+                values=st.one_of(
+                    st.text(min_size=0, max_size=50),
+                    st.integers(min_value=-1000, max_value=1000),
+                    st.booleans(),
+                    st.none(),
+                ),
+                min_size=1,
+                max_size=5
+            ))
+            
+            # Create a JSONField
+            field = models.JSONField()
+            
+            # Call display_for_field with the JSON value
+            result = display_for_field(json_value, field, '-empty-')
+            
+            # The result should be valid JSON (with double quotes)
+            # This assertion will FAIL on buggy version (which returns Python dict repr with single quotes)
+            # and PASS on fixed version (which returns proper JSON with double quotes)
+            try:
+                # If result is valid JSON, this will succeed
+                parsed = json.loads(result)
+                # The parsed value should match the original
+                assert parsed == json_value
+            except (json.JSONDecodeError, TypeError) as e:
+                # If we can't parse it as JSON, the bug is present
+                # On buggy version: result will be like "{'foo': 'bar'}" which is not valid JSON
+                # On fixed version: result will be like '{"foo": "bar"}' which is valid JSON
+                raise AssertionError(f"display_for_field returned invalid JSON: {result}") from e
+                
+    finally:
+        teardown_state(state)
+
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

