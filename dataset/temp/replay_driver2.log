@@ -545,11 +545,140 @@ class Query(BaseExpression):
 
         return dict(zip(outer_query.annotation_select, result))
 
+    def _get_referenced_annotations(self, annotations_to_check):
+        """
+        Find all annotations that are referenced in filters, ordering,
+        or by other annotations.
+        
+        Args:
+            annotations_to_check: A list of annotation aliases to check for references
+            
+        Returns:
+            A set of annotation aliases that are referenced
+        """
+        def find_annotation_refs_in_tree(obj, exclude_self=None):
+            """Find all references to annotations in an expression tree."""
+            refs = set()
+            
+            if isinstance(obj, Ref):
+                if obj.refs != exclude_self and obj.refs in annotations_to_check:
+                    refs.add(obj.refs)
+                return refs
+            
+            # Check if obj is itself one of the annotations we're checking
+            for alias in annotations_to_check:
+                if alias in self.annotations and obj is self.annotations[alias]:
+                    if alias != exclude_self:
+                        refs.add(alias)
+            
+            # Check if it has get_source_expressions
+            if hasattr(obj, 'get_source_expressions'):
+                for expr in obj.get_source_expressions():
+                    refs.update(find_annotation_refs_in_tree(expr, exclude_self))
+            
+            # Check if it has children (for WhereNode)
+            if hasattr(obj, 'children'):
+                for child in obj.children:
+                    refs.update(find_annotation_refs_in_tree(child, exclude_self))
+            
+            return refs
+        
+        referenced = set()
+        
+        # Check filters (where clause)
+        if self.where:
+            referenced.update(find_annotation_refs_in_tree(self.where))
+        
+        # Check ordering
+        if self.order_by:
+            for order_expr in self.order_by:
+                # order_by can be a string like 'field_name' or '-field_name'
+                if isinstance(order_expr, str):
+                    field_name = order_expr.lstrip('-')
+                    if field_name in annotations_to_check:
+                        referenced.add(field_name)
+                else:
+                    # It's an expression, check if it references annotations
+                    referenced.update(find_annotation_refs_in_tree(order_expr))
+        
+        # Handle transitive references (annotation A -> B -> C)
+        # Keep expanding until no new references are found
+        changed = True
+        while changed:
+            old_size = len(referenced)
+            for alias in list(referenced):
+                if alias in self.annotations:
+                    refs = find_annotation_refs_in_tree(
+                        self.annotations[alias],
+                        exclude_self=alias
+                    )
+                    referenced.update(refs)
+            changed = len(referenced) > old_size
+        
+        return referenced
+
+    def _get_aliases_from_expression(self, expr):
+        """Get all table aliases referenced in an expression tree."""
+        aliases = set()
+        
+        if isinstance(expr, Col):
+            if expr.alias:
+                aliases.add(expr.alias)
+        
+        # Check if it has get_source_expressions
+        if hasattr(expr, 'get_source_expressions'):
+            for source_expr in expr.get_source_expressions():
+                aliases.update(self._get_aliases_from_expression(source_expr))
+        
+        # Check if it has children (for WhereNode)
+        if hasattr(expr, 'children'):
+            for child in expr.children:
+                aliases.update(self._get_aliases_from_expression(child))
+        
+        return aliases
+
+
     def get_count(self, using):
         """
         Perform a COUNT() query using the current filter constraints.
         """
         obj = self.clone()
+        # Strip out unreferenced annotations to simplify the count query.
+        # However, we need to be careful about annotations that contain aggregates,
+        # as they affect GROUP BY semantics. If there are any aggregate annotations,
+        # we can only remove annotations that are non-aggregates AND unreferenced,
+        # UNLESS all aggregates are unreferenced (in which case we can remove all
+        # unreferenced annotations).
+        if obj.annotations:
+            annotation_aliases = list(obj.annotations.keys())
+            referenced_annotations = obj._get_referenced_annotations(annotation_aliases)
+            
+            # Identify which annotations are aggregates
+            aggregate_aliases = {
+                alias for alias in annotation_aliases
+                if getattr(obj.annotations[alias], "contains_aggregate", False)
+            }
+            
+            # Identify which aggregates are referenced
+            referenced_aggregates = aggregate_aliases & referenced_annotations
+            
+            # If there are referenced aggregates, we must keep all annotations
+            # to preserve GROUP BY semantics. If there are no referenced aggregates,
+            # we can remove all unreferenced annotations (including unreferenced
+            # aggregates).
+            if not referenced_aggregates:
+                # Safe to remove all unreferenced annotations
+                for alias in annotation_aliases:
+                    if alias not in referenced_annotations:
+                        annotation_expr = obj.annotations[alias]
+                        used_aliases = obj._get_aliases_from_expression(annotation_expr)
+                        del obj.annotations[alias]
+                        if obj.annotation_select_mask is not None and alias in obj.annotation_select_mask:
+                            obj.annotation_select_mask.discard(alias)
+                        for used_alias in used_aliases:
+                            if used_alias in obj.alias_refcount and obj.alias_refcount[used_alias] > 0:
+                                obj.unref_alias(used_alias, 1)
+                obj._annotation_select_cache = None
         obj.add_annotation(Count("*"), alias="__count", is_summary=True)
         return obj.get_aggregation(using, ["__count"])["__count"]
 
