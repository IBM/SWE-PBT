+import sys
+import os
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings
+from hypothesis import HealthCheck
+
+from django.test import RequestFactory
+from django.views import View
+from django.views.debug import ExceptionReporter
+from django.conf import settings as django_settings
+
+# Helper functions (ONLY for test setup/teardown and data construction):
+def setup_state():
+    """Configure Django settings if not already configured."""
+    if not django_settings.configured:
+        django_settings.configure(
+            DEBUG=True,
+            SECRET_KEY='test-secret-key',
+            ROOT_URLCONF='',
+            MIDDLEWARE=[],
+        )
+    return RequestFactory()
+
+def teardown_state(state):
+    """No cleanup needed for RequestFactory."""
+    pass
+
+def create_exception_with_suppress_context(inner_msg, outer_msg):
+    """Create an exception raised with 'from None' to set __suppress_context__=True."""
+    try:
+        try:
+            raise RuntimeError(inner_msg)
+        except Exception:
+            raise ValueError(outer_msg) from None
+    except ValueError as e:
+        return e
+
+def create_exception_with_explicit_cause(inner_msg, outer_msg):
+    """Create an exception with explicit __cause__."""
+    try:
+        try:
+            raise RuntimeError(inner_msg)
+        except Exception as inner:
+            raise ValueError(outer_msg) from inner
+    except ValueError as e:
+        return e
+
+def create_exception_with_implicit_context(inner_msg, outer_msg):
+    """Create an exception with implicit __context__ (no 'from')."""
+    try:
+        try:
+            raise RuntimeError(inner_msg)
+        except Exception:
+            raise ValueError(outer_msg)
+    except ValueError as e:
+        return e
+
+# Property-based test:
+@given(data=st.data())
+@settings(max_examples=2000, deadline=None, suppress_health_check=[HealthCheck.function_scoped_fixture, HealthCheck.too_slow, HealthCheck.filter_too_much])
+def test_exception_reporter_suppress_context(data):
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    factory = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test: Test cases that already work correctly
+            # Test explicit __cause__ (should always be shown)
+            inner_msg = data.draw(st.text(min_size=1, max_size=50))
+            outer_msg = data.draw(st.text(min_size=1, max_size=50))
+            
+            exc = create_exception_with_explicit_cause(inner_msg, outer_msg)
+            request = factory.get('/test/')
+            reporter = ExceptionReporter(request, type(exc), exc, exc.__traceback__)
+            
+            frames = reporter.get_traceback_frames()
+            
+            # When __cause__ is set, it should be included in frames
+            # The frames list contains frame information, and we check that
+            # the exception chain is processed (non-empty frames)
+            assert isinstance(frames, list), "get_traceback_frames should return a list"
+            
+            # Verify that __cause__ is respected (this already works correctly)
+            assert exc.__cause__ is not None, "Explicit cause should be set"
+            assert exc.__cause__.__class__.__name__ == 'RuntimeError'
+            
+        elif is_regression == "false":
+            # Reproduction test: Test the bug with 'raise ... from None'
+            inner_msg = data.draw(st.text(min_size=1, max_size=50))
+            outer_msg = data.draw(st.text(min_size=1, max_size=50))
+            
+            exc = create_exception_with_suppress_context(inner_msg, outer_msg)
+            request = factory.get('/test/')
+            reporter = ExceptionReporter(request, type(exc), exc, exc.__traceback__)
+            
+            # Verify the exception has the expected attributes
+            assert exc.__suppress_context__ is True, "Exception should have __suppress_context__=True"
+            assert exc.__context__ is not None, "Exception should have __context__ set"
+            assert exc.__cause__ is None, "Exception should have __cause__=None (from None)"
+            
+            frames = reporter.get_traceback_frames()
+            
+            # Expected: When __suppress_context__ is True, the context should NOT be shown
+            # We check this by examining the frames - the inner exception should not appear
+            # The bug is that explicit_or_implicit_cause returns __context__ even when suppressed
+            
+            # Collect all exception types mentioned in the frames
+            exception_types_in_frames = set()
+            for frame_data in frames:
+                if isinstance(frame_data, dict) and 'exc_cause' in frame_data:
+                    exc_cause = frame_data['exc_cause']
+                    if exc_cause is not None:
+                        exception_types_in_frames.add(type(exc_cause).__name__)
+            
+            # The inner RuntimeError should NOT appear in frames when __suppress_context__=True
+            # This assertion will FAIL on buggy code (which includes RuntimeError)
+            # and PASS on fixed code (which respects __suppress_context__)
+            assert 'RuntimeError' not in exception_types_in_frames, \
+                "Suppressed context (RuntimeError) should not appear in traceback frames when __suppress_context__=True"
+            
+    finally:
+        teardown_state(factory)
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

