+
+
+def setup_state():
+    """Create a fresh StringIO buffer for each test iteration."""
+    return StringIO()
+
+
+def teardown_state(state):
+    """Close the StringIO buffer."""
+    if state is not None:
+        state.close()
+
+
+@given(data=st.data())
+@settings(
+    max_examples=20000,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test_rst_header_rows(data):
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test: Test that RST format works WITHOUT header_rows
+            # This should pass on both buggy and fixed versions
+            
+            # Draw table data
+            wave_values = data.draw(
+                st.lists(
+                    st.floats(min_value=100.0, max_value=2000.0, allow_nan=False, allow_infinity=False),
+                    min_size=1,
+                    max_size=5
+                )
+            )
+            response_values = data.draw(
+                st.lists(
+                    st.floats(min_value=0.0, max_value=10.0, allow_nan=False, allow_infinity=False),
+                    min_size=len(wave_values),
+                    max_size=len(wave_values)
+                )
+            )
+            
+            # Create table
+            tbl = QTable({
+                'wave': wave_values * u.nm,
+                'response': response_values * u.count
+            })
+            
+            # Write without header_rows (should work on both buggy and fixed)
+            output = StringIO()
+            tbl.write(output, format="ascii.rst")
+            result = output.getvalue()
+            output.close()
+            
+            # Assert basic properties that should hold for RST format
+            # The output should contain separator lines with '=' characters
+            lines = result.strip().split('\n')
+            assert len(lines) >= 3, "RST output should have at least 3 lines"
+            assert all(c in '= ' for c in lines[0]), "First line should be separator"
+            assert all(c in '= ' for c in lines[-1]), "Last line should be separator"
+            
+        elif is_regression == "false":
+            # Reproduction test: Test that RST format works WITH header_rows
+            # This should fail on buggy version (TypeError) but pass on fixed version
+            
+            # Draw table data
+            wave_values = data.draw(
+                st.lists(
+                    st.floats(min_value=100.0, max_value=2000.0, allow_nan=False, allow_infinity=False),
+                    min_size=1,
+                    max_size=5
+                )
+            )
+            response_values = data.draw(
+                st.lists(
+                    st.floats(min_value=0.0, max_value=10.0, allow_nan=False, allow_infinity=False),
+                    min_size=len(wave_values),
+                    max_size=len(wave_values)
+                )
+            )
+            
+            # Create table
+            tbl = QTable({
+                'wave': wave_values * u.nm,
+                'response': response_values * u.count
+            })
+            
+            # Try to write with header_rows (should fail on buggy, succeed on fixed)
+            output = StringIO()
+            try:
+                tbl.write(output, format="ascii.rst", header_rows=["name", "unit"])
+                result = output.getvalue()
+                output.close()
+                
+                # If we get here, the call succeeded (fixed version)
+                # Assert that the output contains the expected structure
+                lines = result.strip().split('\n')
+                
+                # The output should have:
+                # 1. Separator line
+                # 2. Column names (wave, response)
+                # 3. Units (nm, ct)
+                # 4. Separator line
+                # 5. Data rows
+                # 6. Separator line
+                assert len(lines) >= 5, "RST output with header_rows should have at least 5 lines"
+                
+                # Check that 'wave' and 'response' appear in the output
+                full_output = result.lower()
+                assert 'wave' in full_output, "Column name 'wave' should appear in output"
+                assert 'response' in full_output, "Column name 'response' should appear in output"
+                
+                # Check that units appear (nm and ct)
+                assert 'nm' in result or 'ct' in result, "Units should appear in output"
+                
+            except TypeError as e:
