+import sys
+import os
+import tempfile
+import shutil
+from pathlib import Path
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+from io import StringIO
+
+from django.core import management
+from django.core.management.base import BaseCommand, CommandError
+from django.test import SimpleTestCase
+from django.conf import settings
+
+# Helper functions for test setup/teardown:
+def setup_state():
+    """Create a temporary Django management command with subparsers."""
+    # Create a temporary directory for the management command
+    temp_dir = tempfile.mkdtemp()
+    
+    # Create the management command structure
+    management_dir = Path(temp_dir) / "management"
+    commands_dir = management_dir / "commands"
+    commands_dir.mkdir(parents=True)
+    
+    # Create __init__.py files
+    (management_dir / "__init__.py").write_text("")
+    (commands_dir / "__init__.py").write_text("")
+    
+    return {
+        'temp_dir': temp_dir,
+        'commands_dir': commands_dir
+    }
+
+def teardown_state(state):
+    """Clean up the temporary directory."""
+    if state and 'temp_dir' in state:
+        shutil.rmtree(state['temp_dir'], ignore_errors=True)
+
+def create_command_with_subparser(commands_dir, command_name, subcommand_name, arg_name):
+    """Create a management command file with a subparser."""
+    command_content = f'''
+from django.core.management.base import BaseCommand
+
+class Command(BaseCommand):
+    def add_arguments(self, parser):
+        subparsers = parser.add_subparsers(required=True, dest='subcommand')
+        subparser = subparsers.add_parser("{subcommand_name}")
+        subparser.add_argument("{arg_name}")
+    
+    def handle(self, *args, **options):
+        self.stdout.write("Success")
+'''
+    command_file = commands_dir / f"{command_name}.py"
+    command_file.write_text(command_content)
+    return command_file
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(max_examples=2000, deadline=None, suppress_health_check=[HealthCheck.function_scoped_fixture, HealthCheck.too_slow, HealthCheck.filter_too_much])
+def test(data):
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test that main parser arguments work correctly
+            # This behavior should already work in the buggy repository
+            
+            # Draw a valid command name and argument
+            command_name = data.draw(st.text(min_size=1, max_size=20, alphabet=st.characters(whitelist_categories=('Ll',))))
+            subcommand_name = data.draw(st.text(min_size=1, max_size=20, alphabet=st.characters(whitelist_categories=('Ll',))))
+            arg_name = data.draw(st.text(min_size=1, max_size=20, alphabet=st.characters(whitelist_categories=('Ll',))))
+            
+            # Create the command
+            create_command_with_subparser(state['commands_dir'], command_name, subcommand_name, arg_name)
+            
+            # Add the temp directory to sys.path
+            sys.path.insert(0, state['temp_dir'])
+            
+            try:
+                # Test that missing subcommand (main parser level) raises CommandError properly
+                # This should work correctly even in buggy version
+                with self.assertRaises(CommandError) as cm:
+                    management.call_command(command_name)
+                
+                # The error message should contain information about required subcommand
+                error_msg = str(cm.exception)
