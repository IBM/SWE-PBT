+            
+            symbol_name = f'{base_name}_{subscript}'
+            sym = Symbol(symbol_name)
+            result = upretty(sym)
+            
+            # Expected: subscript should be formatted as Unicode subscript
+            # Mapping for Unicode subscripts
+            subscript_map = {'0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄',
+                           '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉'}
+            expected_subscript = subscript_map[str(subscript)]
+            expected = f'{base_name}{expected_subscript}'
