+import sys
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+import matplotlib
+matplotlib.use('Agg')  # Use non-interactive backend for testing
+import matplotlib.pyplot as plt
+from matplotlib import get_backend, rc_context
+
+
+# Helper functions (ONLY for test setup/teardown and data construction):
+def setup_state():
+    """Setup: close all figures and return initial state."""
+    plt.close('all')
+    return None
+
+
+def teardown_state(state):
+    """Teardown: close all figures."""
+    plt.close('all')
+
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(
+    max_examples=2000,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test(data):
+    import os
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test already correct behavior
+            # Case 1: Create a figure BEFORE rc_context (this works correctly)
+            # Case 2: Use plt.ion() before creating figures (this works correctly)
+            
+            test_case = data.draw(st.sampled_from(['before_rc_context', 'with_ion']))
+            
+            if test_case == 'before_rc_context':
+                # Create a figure before rc_context - this should work correctly
+                fig1 = plt.figure()
+                with rc_context():
+                    fig2 = plt.figure()
+                
+                # Get the figures before calling get_backend
+                figs_before = dict(plt._pylab_helpers.Gcf.figs)
+                num_figs_before = len(figs_before)
+                
+                # Call get_backend
+                get_backend()
+                
+                # Get the figures after calling get_backend
+                figs_after = dict(plt._pylab_helpers.Gcf.figs)
+                num_figs_after = len(figs_after)
+                
+                # Assert that figures are preserved (already correct behavior)
+                assert num_figs_before == num_figs_after, \
+                    f"Figures should be preserved: before={num_figs_before}, after={num_figs_after}"
+                assert figs_before.keys() == figs_after.keys(), \
+                    "Figure keys should remain the same"
+                    
+            elif test_case == 'with_ion':
+                # Use plt.ion() before creating figures - this should work correctly
+                plt.ion()
+                with rc_context():
+                    fig = plt.figure()
+                
+                # Get the figures before calling get_backend
+                figs_before = dict(plt._pylab_helpers.Gcf.figs)
+                num_figs_before = len(figs_before)
+                
+                # Call get_backend
+                get_backend()
+                
+                # Get the figures after calling get_backend
+                figs_after = dict(plt._pylab_helpers.Gcf.figs)
+                num_figs_after = len(figs_after)
+                
+                # Assert that figures are preserved (already correct behavior)
+                assert num_figs_before == num_figs_after, \
+                    f"Figures should be preserved: before={num_figs_before}, after={num_figs_after}"
+                assert figs_before.keys() == figs_after.keys(), \
+                    "Figure keys should remain the same"
+                plt.ioff()
+                
+        elif is_regression == "false":
+            # Reproduction test logic: Test the buggy behavior
+            # Create a figure inside rc_context as the FIRST figure (triggers bug)
+            
+            with rc_context():
+                fig = plt.figure()
+            
+            # Get the figures before calling get_backend
+            figs_before = dict(plt._pylab_helpers.Gcf.figs)
+            num_figs_before = len(figs_before)
+            fig_keys_before = set(figs_before.keys())
+            
+            # Call get_backend (this triggers the bug)
+            get_backend()
+            
+            # Get the figures after calling get_backend
+            figs_after = dict(plt._pylab_helpers.Gcf.figs)
+            num_figs_after = len(figs_after)
+            fig_keys_after = set(figs_after.keys())
+            
+            # Assert the expected behavior: figures should NOT be cleared
+            # This will FAIL on buggy version (where figures are cleared)
+            # and PASS on fixed version (where figures are preserved)
+            assert num_figs_before == num_figs_after, \
