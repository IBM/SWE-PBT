+            'django.contrib.auth',
+        ],
+        USE_TZ=True,
+    )
+    django.setup()
+
+from django.db import models, connection
+from django.test.utils import setup_test_environment, teardown_test_environment
+from hypothesis import given, settings as hypothesis_settings, HealthCheck
+from hypothesis import strategies as st
+
+# Define models
+class Item(models.Model):
+    uid = models.AutoField(primary_key=True, editable=False)
+    f = models.BooleanField(default=False)
+    
+    class Meta:
+        app_label = 'test_app'
+    
+    def reset(self):
+        self.uid = None
+        self.f = False
+
+class Derived(Item):
+    class Meta:
+        app_label = 'test_app'
+
+# Helper functions
+def setup_state():
+    """Setup test database and tables."""
+    setup_test_environment()
+    
+    # Create tables
+    with connection.schema_editor() as schema_editor:
+        schema_editor.create_model(Item)
+        schema_editor.create_model(Derived)
+    
+    return None
+
+def teardown_state(state):
+    """Teardown test database and tables."""
+    # Drop tables
+    with connection.schema_editor() as schema_editor:
+        schema_editor.delete_model(Derived)
+        schema_editor.delete_model(Item)
+    
+    teardown_test_environment()
+
+def clear_tables():
+    """Clear all data from tables between test runs."""
+    Derived.objects.all().delete()
+    Item.objects.all().delete()
+
+# Property-based test
+@given(data=st.data())
+@hypothesis_settings(
+    max_examples=2000,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test(data):
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+    
+    # Clear tables before each example
+    clear_tables()
+    
+    try:
+        if is_regression == "true":
+            # Regression test: Test behavior that already works correctly
+            # Test that creating a new child instance without resetting PK works
+            initial_f_value = data.draw(st.booleans())
+            
+            # Create a derived object
+            derived = Derived.objects.create(f=initial_f_value)
+            original_pk = derived.pk
+            
+            # Retrieve it and verify it exists with correct values
+            retrieved = Derived.objects.get(pk=original_pk)
+            
+            # Assert the already correct behavior: object was created and can be retrieved
+            assert retrieved.pk == original_pk
+            assert retrieved.f == initial_f_value
+            assert Derived.objects.count() == 1
+            
+        elif is_regression == "false":
+            # Reproduction test: Test the buggy behavior
+            initial_f_value = data.draw(st.booleans())
+            
+            # Create the first derived object
+            derived = Derived.objects.create(f=initial_f_value)
+            original_pk = derived.pk
+            
+            # Get the object through Item and downcast to Derived
+            item = Item.objects.get(pk=original_pk)
+            obj1 = item.derived
+            
+            # Reset the primary key and field value
+            obj1.reset()
+            
+            # Save - this should create a NEW object, not overwrite the existing one
+            obj1.save()
+            new_pk = obj1.pk
+            
+            # Expected behavior: A new object should be created
+            # The original object should still exist with its original values
+            assert Derived.objects.count() == 2, \
+                f"Expected 2 objects after reset and save, but got {Derived.objects.count()}"
+            
+            # The new PK should be different from the original
+            assert new_pk != original_pk, \
+                f"Expected new PK {new_pk} to differ from original {original_pk}"
+            
+            # The original object should still exist with original value
+            original_obj = Derived.objects.get(pk=original_pk)
+            assert original_obj.f == initial_f_value, \
+                f"Original object's f field should be {initial_f_value}, but got {original_obj.f}"
+            
+    finally:
+        # Cleanup after each example
+        clear_tables()
