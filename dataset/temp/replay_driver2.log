+import sys
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+from sympy import MatrixSymbol, ZeroMatrix
+from sympy.matrices.expressions.blockmatrix import BlockMatrix, block_collapse
+
+
+# Helper functions for test setup/teardown and data construction:
+def setup_state():
+    """No state needed for this test."""
+    return None
+
+
+def teardown_state(state):
+    """No cleanup needed for this test."""
+    pass
+
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(
+    max_examples=2000,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test(data):
+    import os
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test that single multiplication works correctly
+            # This already works in the buggy version and should continue to work
+            
+            # Draw matrix dimensions (keep small for performance)
+            dim = data.draw(st.integers(min_value=1, max_value=4))
+            
+            # Create a BlockMatrix with ZeroMatrix blocks
+            a = MatrixSymbol("a", dim, dim)
+            z = ZeroMatrix(dim, dim)
+            b = BlockMatrix([[a, z], [z, z]])
+            
+            # Single multiplication should work (already correct behavior)
+            result = block_collapse(b * b)
+            
+            # Assert that the result is computed without error
+            # and has the expected shape
+            assert result.shape == (2 * dim, 2 * dim)
+            
+        elif is_regression == "false":
+            # Reproduction test logic: Test that multiple multiplications fail in buggy version
+            
+            # Draw matrix dimensions (keep small for performance)
+            dim = data.draw(st.integers(min_value=1, max_value=4))
+            
+            # Draw number of multiplications (at least 3 to trigger the bug)
+            num_multiplications = data.draw(st.integers(min_value=3, max_value=5))
+            
+            # Create a BlockMatrix with ZeroMatrix blocks
+            a = MatrixSymbol("a", dim, dim)
+            z = ZeroMatrix(dim, dim)
+            b = BlockMatrix([[a, z], [z, z]])
+            
+            # Build the multiplication expression
+            expr = b
+            for _ in range(num_multiplications - 1):
+                expr = expr * b
+            
+            # This should not raise AttributeError after the fix
+            # In the buggy version, this raises:
+            # AttributeError: 'Zero' object has no attribute 'cols'
+            result = block_collapse(expr)
+            
+            # Assert that the result is computed without error
+            # and has the expected shape
+            assert result.shape == (2 * dim, 2 * dim)
+            
+    finally:
+        teardown_state(state)
+
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

