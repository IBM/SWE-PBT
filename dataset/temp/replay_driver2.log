+import sys
+import os
+import django
+from django.conf import settings
+
+# Configure Django settings before any Django imports
+if not settings.configured:
+    settings.configure(
+        DEBUG=True,
+        DATABASES={
+            'default': {
+                'ENGINE': 'django.db.backends.sqlite3',
+                'NAME': ':memory:',
+            }
+        },
+        INSTALLED_APPS=[
+            'django.contrib.contenttypes',
+            'django.contrib.auth',
+        ],
+        USE_TZ=True,
+        SECRET_KEY='test-secret-key',
+    )
+    django.setup()
+
+from hypothesis import given, assume
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+from django.db import models
+from django.forms import ModelForm
+from django.test.utils import isolate_apps
+
+
+def setup_state():
+    """Create test models and forms dynamically."""
+    return None
+
+
+def teardown_state(state):
+    """Clean up any state."""
+    pass
+
+
+@given(data=st.data())
+@hypothesis_settings(
+    max_examples=2000,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test(data):
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    state = setup_state()
+    try:
+        # Draw test data
+        default_value = data.draw(st.integers(min_value=1, max_value=100))
+        cleaned_data_value = data.draw(st.integers(min_value=101, max_value=200))
+        title_value = data.draw(st.text(min_size=1, max_size=50))
+        
+        # Ensure values are different to detect the bug
+        assume(default_value != cleaned_data_value)
+        
+        with isolate_apps('pbt'):
+            # Create a test model with a field that has a default
+            class TestModel(models.Model):
+                title = models.CharField(max_length=100)
+                score = models.IntegerField(default=default_value)
+                
+                class Meta:
+                    app_label = 'pbt'
+            
+            # Create the table
+            from django.db import connection
+            with connection.schema_editor() as schema_editor:
+                schema_editor.create_model(TestModel)
+            
+            try:
+                if is_regression == "true":
+                    # Regression: Test behavior that already works correctly
+                    # When a field WITH a default IS in the form data, cleaned_data should work
+                    class TestForm(ModelForm):
+                        class Meta:
+                            model = TestModel
+                            fields = ['title', 'score']
+                        
+                        def clean(self):
+                            cleaned_data = super().clean()
+                            # Modify score in cleaned_data
+                            cleaned_data['score'] = cleaned_data_value
+                            return cleaned_data
+                    
+                    # Submit form data that INCLUDES the score field
+                    form_data = {
+                        'title': title_value,
+                        'score': str(default_value),  # Field IS in POST data
+                    }
+                    form = TestForm(form_data)
+                    
+                    if form.is_valid():
+                        instance = form.save(commit=False)
+                        # This should work correctly: cleaned_data value should be used
+                        assert instance.score == cleaned_data_value, \
+                            f"Expected score={cleaned_data_value} from cleaned_data, got {instance.score}"
+                
+                elif is_regression == "false":
+                    # Reproduction: Test the buggy behavior
+                    # When a field WITH a default is NOT in form data, cleaned_data should still work
+                    class TestForm(ModelForm):
+                        class Meta:
+                            model = TestModel
+                            fields = ['title']  # score is NOT in the form
+                        
+                        def clean(self):
+                            cleaned_data = super().clean()
+                            # Set score in cleaned_data even though it's not in the form
+                            cleaned_data['score'] = cleaned_data_value
+                            return cleaned_data
+                    
+                    # Submit form data that does NOT include the score field
+                    form_data = {
+                        'title': title_value,
+                        # 'score' is NOT in POST data
+                    }
+                    form = TestForm(form_data)
+                    
+                    if form.is_valid():
+                        instance = form.save(commit=False)
+                        # BUG: construct_instance ignores cleaned_data['score'] because:
+                        # 1. score has a default value
+                        # 2. score was not in POST data (value_omitted_from_data returns True)
+                        # Expected: instance.score should be cleaned_data_value
+                        # Actual (buggy): instance.score is default_value
+                        assert instance.score == cleaned_data_value, \
+                            f"Expected score={cleaned_data_value} from cleaned_data, but got {instance.score} (default value)"
+            
+            finally:
+                # Drop the table
+                with connection.schema_editor() as schema_editor:
+                    schema_editor.delete_model(TestModel)
+    
+    finally:
+        teardown_state(state)
+
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-seed=0', '-vs'])

