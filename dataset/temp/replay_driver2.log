+import sys
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+from sympy import Symbol
+from sympy.printing.pretty import upretty
+
+# Helper functions (ONLY for test setup/teardown and data construction):
+def setup_state():
+    return None
+
+def teardown_state(state):
+    pass
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(max_examples=20000, deadline=None, suppress_health_check=[HealthCheck.function_scoped_fixture, HealthCheck.too_slow, HealthCheck.filter_too_much])
+def test(data):
+    import os
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test non-Greek symbols with subscripts (already works correctly)
+            # These should have proper Unicode subscripts in both buggy and fixed versions
+            non_greek_names = st.sampled_from(['t', 'w', 'x', 'y', 'z', 'a', 'b', 'c', 'f', 'g'])
+            base_name = data.draw(non_greek_names)
+            subscript = data.draw(st.integers(min_value=0, max_value=9))
+            
+            symbol_name = f'{base_name}_{subscript}'
+            sym = Symbol(symbol_name)
+            result = upretty(sym)
+            
+            # Expected: subscript should be formatted as Unicode subscript
+            # Mapping for Unicode subscripts
+            subscript_map = {'0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄',
+                           '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉'}
+            expected_subscript = subscript_map[str(subscript)]
+            expected = f'{base_name}{expected_subscript}'
+            
+            # This should pass on both buggy and fixed versions
+            assert result == expected, f"Non-Greek symbol {symbol_name} should render as {expected}, got {result}"
+            
+        elif is_regression == "false":
+            # Reproduction test logic: Test Greek symbols with subscripts (buggy behavior)
+            # Greek letter names that should be converted to Unicode
+            greek_names = st.sampled_from(['alpha', 'beta', 'gamma', 'delta', 'epsilon', 
+                                          'omega', 'lambda', 'mu', 'sigma', 'tau', 'phi'])
+            base_name = data.draw(greek_names)
+            subscript = data.draw(st.integers(min_value=0, max_value=9))
+            
+            symbol_name = f'{base_name}_{subscript}'
+            sym = Symbol(symbol_name)
+            result = upretty(sym)
+            
+            # Expected: Greek letter with Unicode subscript
+            # Mapping for Greek letters to Unicode
+            greek_map = {
+                'alpha': 'α', 'beta': 'β', 'gamma': 'γ', 'delta': 'δ',
+                'epsilon': 'ε', 'omega': 'ω', 'lambda': 'λ', 'mu': 'μ',
+                'sigma': 'σ', 'tau': 'τ', 'phi': 'φ'
+            }
+            # Mapping for Unicode subscripts
+            subscript_map = {'0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄',
+                           '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉'}
+            
+            expected_greek = greek_map[base_name]
+            expected_subscript = subscript_map[str(subscript)]
+            expected = f'{expected_greek}{expected_subscript}'
+            
+            # This should fail on buggy version (returns e.g., 'ω0' instead of 'ω₀')
+            # and pass on fixed version
+            assert result == expected, f"Greek symbol {symbol_name} should render as {expected}, got {result}"
+            
+    finally:
+        teardown_state(state)
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

