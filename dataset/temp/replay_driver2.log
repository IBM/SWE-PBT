+    def _get_referenced_annotations(self, annotations_to_check):
+        """
+        Find all annotations that are referenced in filters, ordering,
+        or by other annotations.
+        
+        Args:
+            annotations_to_check: A list of annotation aliases to check for references
+            
+        Returns:
+            A set of annotation aliases that are referenced
+        """
+        def find_annotation_refs_in_tree(obj, exclude_self=None):
+            """Find all references to annotations in an expression tree."""
+            refs = set()
+            
+            if isinstance(obj, Ref):
+                if obj.refs != exclude_self and obj.refs in annotations_to_check:
+                    refs.add(obj.refs)
+                return refs
+            
+            # Check if obj is itself one of the annotations we're checking
+            for alias in annotations_to_check:
+                if alias in self.annotations and obj is self.annotations[alias]:
+                    if alias != exclude_self:
+                        refs.add(alias)
+            
+            # Check if it has get_source_expressions
+            if hasattr(obj, 'get_source_expressions'):
+                for expr in obj.get_source_expressions():
+                    refs.update(find_annotation_refs_in_tree(expr, exclude_self))
+            
+            # Check if it has children (for WhereNode)
+            if hasattr(obj, 'children'):
+                for child in obj.children:
+                    refs.update(find_annotation_refs_in_tree(child, exclude_self))
+            
+            return refs
+        
+        referenced = set()
+        
+        # Check filters (where clause)
+        if self.where:
+            referenced.update(find_annotation_refs_in_tree(self.where))
+        
+        # Check ordering
+        if self.order_by:
+            for order_expr in self.order_by:
+                # order_by can be a string like 'field_name' or '-field_name'
+                if isinstance(order_expr, str):
+                    field_name = order_expr.lstrip('-')
+                    if field_name in annotations_to_check:
+                        referenced.add(field_name)
+                else:
+                    # It's an expression, check if it references annotations
+                    referenced.update(find_annotation_refs_in_tree(order_expr))
+        
+        # Handle transitive references (annotation A -> B -> C)
+        # Keep expanding until no new references are found
+        changed = True
+        while changed:
+            old_size = len(referenced)
+            for alias in list(referenced):
+                if alias in self.annotations:
+                    refs = find_annotation_refs_in_tree(
+                        self.annotations[alias],
+                        exclude_self=alias
+                    )
+                    referenced.update(refs)
+            changed = len(referenced) > old_size
+        
+        return referenced
+
+    def _get_aliases_from_expression(self, expr):
+        """Get all table aliases referenced in an expression tree."""
+        aliases = set()
+        
+        if isinstance(expr, Col):
+            if expr.alias:
+                aliases.add(expr.alias)
+        
+        # Check if it has get_source_expressions
+        if hasattr(expr, 'get_source_expressions'):
+            for source_expr in expr.get_source_expressions():
+                aliases.update(self._get_aliases_from_expression(source_expr))
+        
+        # Check if it has children (for WhereNode)
+        if hasattr(expr, 'children'):
+            for child in expr.children:
+                aliases.update(self._get_aliases_from_expression(child))
