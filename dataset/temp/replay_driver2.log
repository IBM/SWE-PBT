+def test(data):
+    import os
+    from sympy import S, Lambda, imageset, I, FiniteSet
+    from sympy.abc import n
+    
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test that direct membership check works correctly
+            # This behavior is already correct in the buggy repository
+            
+            # Create the imageset S1 = {n + i*(n-1)*(n+1) | n in Integers}
+            S1 = imageset(Lambda(n, n + (n - 1)*(n + 1)*I), S.Integers)
+            
+            # Draw an integer that is NOT -1 or 1 (the only real values in S1)
+            test_value = data.draw(st.integers(min_value=-1000, max_value=1000).filter(lambda x: x not in [-1, 1]))
+            
+            # Direct membership check should return False (already correct)
+            result = test_value in S1
+            assert result == False, f"Direct membership check failed: {test_value} in S1 should be False"
+            
+        elif is_regression == "false":
+            # Reproduction test logic: Test the buggy intersection behavior
+            
+            # Create the imageset S1 = {n + i*(n-1)*(n+1) | n in Integers}
+            S1 = imageset(Lambda(n, n + (n - 1)*(n + 1)*I), S.Integers)
+            
+            # Draw an integer that is NOT -1 or 1 (the only real values in S1)
+            test_value = data.draw(st.integers(min_value=-1000, max_value=1000).filter(lambda x: x not in [-1, 1]))
+            
+            # Get the intersection with Reals
+            intersection = S1.intersect(S.Reals)
+            
+            # Check membership in the intersection
+            # BUG: This incorrectly returns True for values like 2
+            # EXPECTED: Should return False since only -1 and 1 are in S1 ∩ Reals
+            result = test_value in intersection
+            
+            # This assertion should FAIL on buggy repo (when result is True for test_value=2)
+            # and PASS on fixed repo (when result is False)
+            assert result == False, f"Membership check failed: {test_value} should not be in S1.intersect(Reals), but got {result}"
+            
+            # Additional check: the intersection should equal {-1, 1}
+            # For n=-1: -1 + i*(-2)*0 = -1 (real)
+            # For n=0: 0 + i*(-1)*1 = -i (not real)
+            # For n=1: 1 + i*0*2 = 1 (real)
+            # For n=2: 2 + i*1*3 = 2 + 3i (not real)
+            expected_intersection = FiniteSet(-1, 1)
+            assert intersection == expected_intersection, f"Intersection should be {{-1, 1}}, but got {intersection}"
+            
