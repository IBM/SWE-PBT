diff --git a/sympy/matrices/expressions/blockmatrix.py b/sympy/matrices/expressions/blockmatrix.py
index 95302a05ca..b3ee94bec5 100644
--- a/sympy/matrices/expressions/blockmatrix.py
+++ b/sympy/matrices/expressions/blockmatrix.py
@@ -164,7 +164,26 @@ def structurally_equal(self, other):
     def _blockmul(self, other):
         if (isinstance(other, BlockMatrix) and
                 self.colblocksizes == other.rowblocksizes):
-            return BlockMatrix(self.blocks*other.blocks)
+            from sympy.matrices.immutable import ImmutableDenseMatrix
+            
+            # Perform proper block matrix multiplication
+            # to preserve matrix types (e.g., ZeroMatrix instead of scalar Zero)
+            n = self.blockshape[0]  # number of block rows in result
+            m = other.blockshape[1]  # number of block cols in result
+            k = self.blockshape[1]  # number of blocks to sum over
+            
+            result_blocks = []
+            for i in range(n):
+                row = []
+                for j in range(m):
+                    # Compute the (i,j) block as sum of products
+                    s = self.blocks[i, 0] * other.blocks[0, j]
+                    for l in range(1, k):
+                        s = s + self.blocks[i, l] * other.blocks[l, j]
+                    row.append(s)
+                result_blocks.append(row)
+            
+            return BlockMatrix(ImmutableDenseMatrix(result_blocks, evaluate=False))
 
         return self * other
 
