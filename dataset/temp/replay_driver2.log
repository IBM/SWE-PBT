            title_value = data.draw(st.text(min_size=1, max_size=50))
    
            # Ensure values are different to detect the bug
            assume(default_value != cleaned_data_value)
    
            with isolate_apps('pbt'):
                # Create a test model with a field that has a default
                class TestModel(models.Model):
                    title = models.CharField(max_length=100)
                    score = models.IntegerField(default=default_value)
    
                    class Meta:
                        app_label = 'pbt'
    
                # Create the table
                from django.db import connection
                with connection.schema_editor() as schema_editor:
                    schema_editor.create_model(TestModel)
    
                try:
                    if is_regression == "true":
