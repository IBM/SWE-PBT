                                model = TestModel
                                fields = ['title', 'score']
    
                            def clean(self):
                                cleaned_data = super().clean()
                                # Modify score in cleaned_data
                                cleaned_data['score'] = cleaned_data_value
                                return cleaned_data
    
                        # Submit form data that INCLUDES the score field
                        form_data = {
                            'title': title_value,
                            'score': str(default_value),  # Field IS in POST data
                        }
                        form = TestForm(form_data)
    
                        if form.is_valid():
