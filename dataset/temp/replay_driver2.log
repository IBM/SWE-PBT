+import sys
+import os
+import django
+from django.conf import settings
+
+# Configure Django settings before any Django imports
+if not settings.configured:
+    settings.configure(
+        DEBUG=True,
+        DATABASES={
+            'default': {
+                'ENGINE': 'django.db.backends.sqlite3',
+                'NAME': ':memory:',
+            }
+        },
+        INSTALLED_APPS=[
+            'django.contrib.contenttypes',
+            'django.contrib.auth',
+        ],
+        USE_TZ=True,
+    )
+    django.setup()
+
+from django.db import models, connection
+from django.db.models import Count
+from django.test.utils import CaptureQueriesContext
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+# Define test models
+class Author(models.Model):
+    name = models.CharField(max_length=100)
+    age = models.IntegerField()
+    
+    class Meta:
+        app_label = 'test_app'
+
+class Book(models.Model):
+    name = models.CharField(max_length=100)
+    pages = models.IntegerField()
+    author = models.ForeignKey(Author, on_delete=models.CASCADE, related_name='books')
+    
+    class Meta:
+        app_label = 'test_app'
+
+class Chapter(models.Model):
+    title = models.CharField(max_length=100)
+    book = models.ForeignKey(Book, on_delete=models.CASCADE, related_name='chapters')
+    
+    class Meta:
+        app_label = 'test_app'
+
+# Helper functions
+def setup_state():
+    """Create tables and sample data"""
+    with connection.schema_editor() as schema_editor:
+        schema_editor.create_model(Author)
+        schema_editor.create_model(Book)
+        schema_editor.create_model(Chapter)
+    
+    # Create some test data
+    author = Author.objects.create(name='Test Author', age=30)
+    book1 = Book.objects.create(name='Book 1', pages=100, author=author)
+    book2 = Book.objects.create(name='Book 2', pages=200, author=author)
+    Chapter.objects.create(title='Chapter 1', book=book1)
+    Chapter.objects.create(title='Chapter 2', book=book1)
+    Chapter.objects.create(title='Chapter 3', book=book2)
+    
+    return {'author': author, 'book1': book1, 'book2': book2}
+
+def teardown_state(state):
+    """Clean up tables"""
+    try:
+        with connection.schema_editor() as schema_editor:
+            schema_editor.delete_model(Chapter)
+            schema_editor.delete_model(Book)
+            schema_editor.delete_model(Author)
+    except:
+        pass
+
+# Property-based test
+@given(data=st.data())
+@hypothesis_settings(max_examples=20000, deadline=None, suppress_health_check=[HealthCheck.function_scoped_fixture, HealthCheck.too_slow, HealthCheck.filter_too_much])
+def test(data):
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test that simple count queries work correctly
+            # This should pass on both buggy and fixed versions
+            
+            # Draw a simple count operation without annotations
+            use_filter = data.draw(st.booleans())
+            
+            if use_filter:
+                # Count with a simple filter (no annotations)
+                min_pages = data.draw(st.integers(min_value=50, max_value=150))
+                result = Book.objects.filter(pages__gte=min_pages).count()
+            else:
+                # Simple count without any annotations
+                result = Book.objects.count()
+            
+            # Assert that the result is a non-negative integer
+            # This is the already correct behavior
+            assert isinstance(result, int)
+            assert result >= 0
+            
+        elif is_regression == "false":
+            # Reproduction test logic: Test that unused annotations are stripped from count queries
+            # This should fail on buggy version (includes annotation in SQL) 
+            # and pass on fixed version (strips annotation from SQL)
+            
+            # Draw whether to use annotation
+            annotation_field = data.draw(st.sampled_from(['chapters', 'books']))
+            
+            # Capture the SQL for count with annotation
+            with CaptureQueriesContext(connection) as ctx_annotated:
+                if annotation_field == 'chapters':
+                    count_with_annotation = Book.objects.annotate(Count('chapters')).count()
+                else:
+                    count_with_annotation = Author.objects.annotate(Count('books')).count()
+            
+            # Capture the SQL for simple count
+            with CaptureQueriesContext(connection) as ctx_simple:
+                if annotation_field == 'chapters':
+                    count_simple = Book.objects.count()
+                else:
+                    count_simple = Author.objects.count()
+            
+            # The counts should be equal
+            assert count_with_annotation == count_simple
+            
+            # The key assertion: the SQL for annotated count should NOT contain
+            # the annotation field when it's unused (after fix)
+            # On buggy version: SQL contains "COUNT" for the annotation
+            # On fixed version: SQL should be simpler, not containing the unused annotation
+            
+            sql_annotated = ctx_annotated.captured_queries[0]['sql'].upper()
+            sql_simple = ctx_simple.captured_queries[0]['sql'].upper()
+            
+            # After the fix, the annotated count query should be as simple as the simple count
+            # We check that the annotated query doesn't have extra COUNT operations
+            # Count the number of COUNT occurrences in each query
+            count_in_annotated = sql_annotated.count('COUNT')
+            count_in_simple = sql_simple.count('COUNT')
+            
+            # After fix: both should have the same number of COUNT operations
+            # Before fix: annotated query has more COUNT operations
+            assert count_in_annotated == count_in_simple, \
+                f"Unused annotation not stripped: annotated query has {count_in_annotated} COUNTs, simple has {count_in_simple}"
+            
+    finally:
+        teardown_state(state)
+
+# Entry point
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

