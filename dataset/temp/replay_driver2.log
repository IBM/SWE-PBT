+            
+            # Draw a valid command name and argument
+            command_name = data.draw(st.text(min_size=1, max_size=20, alphabet=st.characters(whitelist_categories=('Ll',))))
+            subcommand_name = data.draw(st.text(min_size=1, max_size=20, alphabet=st.characters(whitelist_categories=('Ll',))))
+            arg_name = data.draw(st.text(min_size=1, max_size=20, alphabet=st.characters(whitelist_categories=('Ll',))))
+            
+            # Create the command
+            create_command_with_subparser(state['commands_dir'], command_name, subcommand_name, arg_name)
+            
+            # Add the temp directory to sys.path
+            sys.path.insert(0, state['temp_dir'])
+            
+            try:
+                # Test that missing argument to subparser raises CommandError
+                # In buggy version: raises CommandError (but as stack trace)
+                # In fixed version: should raise CommandError with proper formatting
+                
+                error_raised = False
+                error_message = ""
+                
+                try:
+                    # Call with subcommand but without required argument
+                    management.call_command(command_name, subcommand_name)
+                except CommandError as e:
+                    error_raised = True
+                    error_message = str(e)
+                except SystemExit:
+                    # In some cases, argparse might call sys.exit
+                    error_raised = True
+                    error_message = "SystemExit"
+                
+                # The bug is that it raises CommandError with stack trace
+                # The fix should make it raise CommandError with proper message
+                # We assert that CommandError is raised (which happens in both cases)
+                # but the key difference is HOW it's raised (stack trace vs proper error)
+                
+                # For reproduction: we expect CommandError to be raised
+                assert error_raised, "Expected CommandError to be raised for missing subparser argument"
+                
+                # The error message should mention the missing argument
+                # This assertion will pass on fixed version where error formatting is proper
+                assert arg_name in error_message or "required" in error_message.lower()
+                
+            finally:
+                # Remove from sys.path
+                if state['temp_dir'] in sys.path:
+                    sys.path.remove(state['temp_dir'])
+                    
+    finally:
+        teardown_state(state)
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

