+import sys
+from hypothesis import given, assume
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+from django.contrib.admindocs.utils import replace_named_groups
+
+
+# Helper functions for test setup/teardown:
+def setup_state():
+    """No state needed for this test."""
+    return None
+
+
+def teardown_state(state):
+    """No cleanup needed for this test."""
+    pass
+
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(
+    max_examples=200,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test(data):
+    import os
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test: patterns WITH trailing content after last named group
+            # These should work correctly in both buggy and fixed versions
+            
+            # Draw a valid group name
+            group_name = data.draw(
+                st.text(
+                    alphabet=st.characters(whitelist_categories=('Lu', 'Ll', 'Nd'), min_codepoint=97, max_codepoint=122),
+                    min_size=1,
+                    max_size=10
+                ).filter(lambda x: x.isidentifier())
+            )
+            
+            # Draw a pattern for the group (simple character class)
+            group_pattern = data.draw(st.sampled_from([r'\w+', r'[^/.]+', r'\d+', r'[a-z]+']))
+            
+            # Draw trailing content (non-empty to ensure it's after the last group)
+            trailing = data.draw(st.sampled_from(['/', '/test', '/abc/', '$']))
+            
+            # Construct pattern with trailing content
+            pattern = f'^(?P<{group_name}>{group_pattern}){trailing}'
+            
+            # Call the real function
+            result = replace_named_groups(pattern)
+            
+            # Assert that the named group IS replaced (this works in buggy version)
+            assert f'(?P<{group_name}>' not in result, \
+                f"Named group should be replaced when there's trailing content"
+            assert f'<{group_name}>' in result, \
+                f"Group name should appear in angle brackets"
+            
+        elif is_regression == "false":
+            # Reproduction test: patterns WITHOUT trailing content after last named group
+            # These expose the bug
+            
+            # Draw valid group names
+            group_name1 = data.draw(
+                st.text(
+                    alphabet=st.characters(whitelist_categories=('Lu', 'Ll', 'Nd'), min_codepoint=97, max_codepoint=122),
+                    min_size=1,
+                    max_size=10
+                ).filter(lambda x: x.isidentifier())
+            )
+            
+            group_name2 = data.draw(
+                st.text(
+                    alphabet=st.characters(whitelist_categories=('Lu', 'Ll', 'Nd'), min_codepoint=97, max_codepoint=122),
+                    min_size=1,
+                    max_size=10
+                ).filter(lambda x: x.isidentifier() and x != group_name1)
+            )
+            
+            # Draw patterns for the groups
+            group_pattern1 = data.draw(st.sampled_from([r'\w+', r'[^/.]+', r'\d+']))
+            group_pattern2 = data.draw(st.sampled_from([r'\w+', r'[^/.]+', r'\d+']))
+            
+            # Construct pattern WITHOUT trailing content after the last group
+            # This is the bug trigger
+            pattern = f'entries/(?P<{group_name1}>{group_pattern1})/relationships/(?P<{group_name2}>{group_pattern2})'
+            
+            # Call the real function
+            result = replace_named_groups(pattern)
+            
+            # Assert expected behavior: ALL named groups should be replaced
+            # This will FAIL on buggy version (last group not replaced)
+            # and PASS on fixed version (all groups replaced)
+            assert f'(?P<{group_name1}>' not in result, \
+                f"First named group should be replaced"
+            assert f'(?P<{group_name2}>' not in result, \
+                f"Last named group should be replaced (BUG: it's not in buggy version)"
+            assert f'<{group_name1}>' in result, \
+                f"First group name should appear in angle brackets"
+            assert f'<{group_name2}>' in result, \
+                f"Last group name should appear in angle brackets (BUG: it doesn't in buggy version)"
+            
+    finally:
+        teardown_state(state)
+
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

