+import sys
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+from sympy.sets import FiniteSet, ProductSet
+
+# Helper functions (ONLY for test setup/teardown and data construction):
+def setup_state():
+    return None
+
+def teardown_state(state):
+    pass
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(max_examples=20000, deadline=None, suppress_health_check=[HealthCheck.function_scoped_fixture, HealthCheck.too_slow, HealthCheck.filter_too_much])
+def test(data):
+    import os
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic: Test that c.is_subset(b) works correctly
+            # This already works in the buggy version and should continue to work
+            
+            # Draw two small sets of integers to create ProductSet and FiniteSet
+            size1 = data.draw(st.integers(min_value=1, max_value=3))
+            size2 = data.draw(st.integers(min_value=1, max_value=3))
+            
+            elements1 = data.draw(st.lists(st.integers(min_value=1, max_value=5), 
+                                          min_size=size1, max_size=size1, unique=True))
+            elements2 = data.draw(st.lists(st.integers(min_value=1, max_value=5), 
+                                          min_size=size2, max_size=size2, unique=True))
+            
+            a1 = FiniteSet(*elements1)
+            a2 = FiniteSet(*elements2)
+            b = ProductSet(a1, a2)
+            
+            # Create the equivalent FiniteSet with explicit tuples
+            tuples = [(x, y) for x in elements1 for y in elements2]
+            c = FiniteSet(*tuples)
+            
+            # Test the already correct behavior: c.is_subset(b) should return True
+            # This passes on buggy repository and should pass on fixed repository
+            result = c.is_subset(b)
+            assert result is True, f"c.is_subset(b) should be True, got {result}"
+            
+        elif is_regression == "false":
+            # Reproduction test logic: Test that b.is_subset(c) fails in buggy version
+            
+            # Draw two small sets of integers to create ProductSet and FiniteSet
+            size1 = data.draw(st.integers(min_value=1, max_value=3))
+            size2 = data.draw(st.integers(min_value=1, max_value=3))
+            
+            elements1 = data.draw(st.lists(st.integers(min_value=1, max_value=5), 
+                                          min_size=size1, max_size=size1, unique=True))
+            elements2 = data.draw(st.lists(st.integers(min_value=1, max_value=5), 
+                                          min_size=size2, max_size=size2, unique=True))
+            
+            a1 = FiniteSet(*elements1)
+            a2 = FiniteSet(*elements2)
+            b = ProductSet(a1, a2)
+            
+            # Create the equivalent FiniteSet with explicit tuples
+            tuples = [(x, y) for x in elements1 for y in elements2]
+            c = FiniteSet(*tuples)
+            
+            # Test the buggy behavior: b.is_subset(c) should return True but returns None
+            # This fails on buggy repository but should pass on fixed repository
+            result = b.is_subset(c)
+            assert result is True, f"ProductSet.is_subset(FiniteSet) should be True, got {result}"
+            
+    finally:
+        teardown_state(state)
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

