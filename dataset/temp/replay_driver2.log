@@ -0,0 +1,76 @@
+import sys
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+# Helper functions (ONLY for test setup/teardown and data construction —
+# NOT for reimplementing library logic):
+def setup_state():
+    return None
+
+def teardown_state(state):
+    pass
+
+# Property-based test:
+@given(data=st.data())
+@hypothesis_settings(max_examples=20000, deadline=None, suppress_health_check=[HealthCheck.function_scoped_fixture, HealthCheck.too_slow, HealthCheck.filter_too_much])
+def test(data):
+    import os
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    # --- Setup ---
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test logic:
+            # Test that recognized units handle comparison with None correctly
+            from astropy import units as u
+            
+            # Draw a recognized unit string
+            recognized_unit_strings = ['m', 'kg', 's', 'A', 'K', 'mol', 'cd', 'rad', 'sr', 'Hz', 'N', 'Pa', 'J', 'W']
+            unit_string = data.draw(st.sampled_from(recognized_unit_strings))
+            
+            # Create a recognized unit
+            unit = u.Unit(unit_string)
+            
+            # Test comparison with None - this should work correctly (return False)
+            result = (unit == None)
+            
+            # This assertion should pass on both buggy and fixed versions
+            # because recognized units should handle None comparison correctly
+            assert result is False
+            
+        elif is_regression == "false":
+            # Reproduction test logic:
+            from astropy import units as u
+            
+            # Draw an unrecognized unit string (something that won't parse as a valid unit)
+            unrecognized_string = data.draw(st.text(
+                alphabet=st.characters(whitelist_categories=('Lu', 'Ll'), min_codepoint=97, max_codepoint=122),
+                min_size=1,
+                max_size=10
+            ).filter(lambda s: s not in ['m', 'kg', 's', 'A', 'K', 'mol', 'cd', 'rad', 'sr', 'Hz', 'N', 'Pa', 'J', 'W', 'V', 'C', 'F', 'T', 'H', 'Wb', 'lm', 'lx', 'Bq', 'Gy', 'Sv', 'kat', 'g', 'L', 'eV', 'Da', 'u', 'pc', 'AU', 'ly', 'yr', 'deg', 'arcmin', 'arcsec', 'mas', 'uas']))
+            
+            # Create an UnrecognizedUnit with parse_strict='silent'
+            unrecognized_unit = u.Unit(unrecognized_string, parse_strict='silent')
+            
+            # Test comparison with None
+            # Expected: should return False
+            # Actual (buggy): raises TypeError
+            result = (unrecognized_unit == None)
+            
+            # This assertion captures the expected behavior from the issue
+            # It should fail on buggy repository (TypeError raised) and pass on fixed repository
+            assert result is False
+            
+    finally:
+        teardown_state(state)  # Always clean up, even on failure
+
+# Entry point:
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

