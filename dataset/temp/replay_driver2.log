@@ -0,0 +1,173 @@
+import sys
+import asyncio
+import tempfile
+import os
+from hypothesis import given
+from hypothesis import strategies as st
+from hypothesis import settings as hypothesis_settings
+from hypothesis import HealthCheck
+
+from django.http import HttpResponse
+from django.test import SimpleTestCase, override_settings
+from django.utils.deprecation import MiddlewareMixin
+from django.core.handlers.asgi import ASGIHandler
+from django.conf import settings
+from django.urls import path
+
+
+# Track what the middleware receives
+middleware_responses = []
+
+
+class TrackingMiddleware(MiddlewareMixin):
+    """Middleware that tracks the type of response it receives"""
+    def process_response(self, request, response):
+        middleware_responses.append(type(response).__name__)
+        return response
+
+
+def simple_view(request):
+    return HttpResponse("OK")
+
+
+urlpatterns = [
+    path('test/', simple_view),
+]
+
+
+def setup_state():
+    """Setup Django settings and clear tracking"""
+    global middleware_responses
+    middleware_responses = []
+    
+    if not settings.configured:
+        settings.configure(
+            DEBUG=True,
+            SECRET_KEY='test-secret-key',
+            ROOT_URLCONF=__name__,
+            MIDDLEWARE=[
+                'pbt.test.TrackingMiddleware',
+                'django.middleware.common.CommonMiddleware',
+            ],
+            ALLOWED_HOSTS=['*'],
+        )
+    return None
+
+
+def teardown_state(state):
+    """Clean up tracking data"""
+    global middleware_responses
+    middleware_responses = []
+
+
+@given(data=st.data())
+@hypothesis_settings(
+    max_examples=20000,
+    deadline=None,
+    suppress_health_check=[
+        HealthCheck.function_scoped_fixture,
+        HealthCheck.too_slow,
+        HealthCheck.filter_too_much
+    ]
+)
+def test(data):
+    is_regression = os.environ.get("IS_REGRESSION")
+    if is_regression is None:
+        print("Error: IS_REGRESSION environment variable is not defined.")
+        sys.exit(1)
+
+    state = setup_state()
+    try:
+        if is_regression == "true":
+            # Regression test: Test that non-first middleware receives HttpResponse correctly
+            # This behavior is already correct in the buggy version
+            
+            # Draw a position for our tracking middleware (not first)
+            middleware_position = data.draw(st.integers(min_value=1, max_value=3))
+            
+            # Configure middleware with tracking middleware NOT in first position
+            middleware_list = ['django.middleware.security.SecurityMiddleware']
+            for i in range(1, middleware_position):
+                middleware_list.append('django.middleware.common.CommonMiddleware')
+            middleware_list.append('pbt.test.TrackingMiddleware')
+            
+            with override_settings(
+                MIDDLEWARE=middleware_list,
+                ROOT_URLCONF=__name__,
+            ):
+                handler = ASGIHandler()
+                scope = {
+                    'type': 'http',
+                    'method': 'GET',
+                    'path': '/test/',
+                    'query_string': b'',
+                    'headers': [],
+                    'server': ('testserver', 80),
+                    'asgi': {'version': '3.0'},
+                    'http_version': '1.1',
+                }
+                
+                async def receive():
+                    return {'type': 'http.request', 'body': b''}
+                
+                responses = []
+                async def send(message):
+                    responses.append(message)
+                
+                # Execute the request
+                asyncio.run(handler(scope, receive, send))
+                
+                # Assert: non-first middleware should receive HttpResponse (already works)
+                assert len(middleware_responses) > 0
+                assert middleware_responses[0] == 'HttpResponse', \
+                    f"Non-first middleware should receive HttpResponse, got {middleware_responses[0]}"
+                    
+        elif is_regression == "false":
+            # Reproduction test: Test that first middleware receives coroutine (the bug)
+            
+            # Draw some variation in the middleware chain
+            num_following_middlewares = data.draw(st.integers(min_value=1, max_value=3))
+            
+            # Configure with tracking middleware in FIRST position
+            middleware_list = ['pbt.test.TrackingMiddleware']
+            for _ in range(num_following_middlewares):
+                middleware_list.append('django.middleware.common.CommonMiddleware')
+            
+            with override_settings(
+                MIDDLEWARE=middleware_list,
+                ROOT_URLCONF=__name__,
+            ):
+                handler = ASGIHandler()
+                scope = {
+                    'type': 'http',
+                    'method': 'GET',
+                    'path': '/test/',
+                    'query_string': b'',
+                    'headers': [],
+                    'server': ('testserver', 80),
+                    'asgi': {'version': '3.0'},
+                    'http_version': '1.1',
+                }
+                
+                async def receive():
+                    return {'type': 'http.request', 'body': b''}
+                
+                responses = []
+                async def send(message):
+                    responses.append(message)
+                
+                # Execute the request
+                asyncio.run(handler(scope, receive, send))
+                
+                # Assert: first middleware should receive HttpResponse, not coroutine
+                assert len(middleware_responses) > 0
+                assert middleware_responses[0] == 'HttpResponse', \
+                    f"First middleware should receive HttpResponse, but got {middleware_responses[0]}"
+                    
+    finally:
+        teardown_state(state)
+
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__, '--hypothesis-verbosity=verbose', '--hypothesis-log-all', '-vs'])

